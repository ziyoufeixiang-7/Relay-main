"""
ApiDiffTest.py — 差动试验 API

支持两种接线模式：
  - ext-differential (6I): 扩展差动，使用 compute_6ch → 6 路三相电流
  - phase-differential (2I): 分相差动，使用 compute_2i → 2 路标量电流（带 √3 校正）

3 节点 FSM 架构：
  Node 1 (故障前): 静态电压 + 零电流, 超时跳转 Node 2
  Node 2 (故障态): 计算的电流, DI 匹配或超时跳转 Node 3
  Node 3 (挂起):   静态电压 + 零电流, 等待 API 手动触发下一轮
"""

import logging
import asyncio
import math
from typing import Dict, Any, List, Optional, Tuple

from api.BaseApi import BaseApi, ApiNodeData
from calc.diff_bridge import compute_6ch, compute_2i
from utils.SearchAlgo import searchBoundary

logger = logging.getLogger("ApiDiffTest")

# ══════════════════════════════════════════
# 通道映射常量
# ══════════════════════════════════════════
# 前端 API 通道索引: 0~5 = 电压 (Ua,Ub,Uc,Ux,Uy,Uz), 6~11 = 电流 (Ia,Ib,Ic,Ix,Iy,Iz)
# physDictToReg 内部会自动调用 MapChannel 转换到硬件通道

# 全部电流通道（用于归零）
ALL_CURRENT_CHANNELS = ["6", "7", "8", "9", "10", "11"]

# 测试相 → 6I 侧内通道偏移（high-y=[6,7,8] / low-y=[9,10,11] 内的索引）
PHASE_OFFSETS = {
    "A": [0], "B": [1], "C": [2],
    "AB": [0, 1], "BC": [1, 2], "CA": [2, 0],
    "ABC": [0, 1, 2],
}
# 三相标称相角
NOMINAL_ANG = [0.0, -120.0, 120.0]

# 扩展差动 (6I) 端子映射
TERMINAL_6I = {
    "high-y": ["6", "7", "8"],      # Ia, Ib, Ic
    "low-y":  ["9", "10", "11"],     # Ix, Iy, Iz
}

# 分相差动 (2I) 端子映射：每个端子选项 → 输出到哪些通道（并联）
TERMINAL_2I = {
    # 单通道
    "ia": ["6"], "ib": ["7"], "ic": ["8"],
    "ix": ["9"], "iy": ["10"], "iz": ["11"],
    # 两并
    "iab": ["6", "7"], "ibc": ["7", "8"], "ica": ["8", "6"],
    "ixy": ["9", "10"], "iyz": ["10", "11"], "izx": ["11", "9"],
    # 三并
    "iabc": ["6", "7", "8"],
    "ixyz": ["9", "10", "11"],
}


class ApiDiffTest(BaseApi):
    MODULE_KEY = "differential_test"

    def __init__(self):
        super().__init__()
        self._payload: Dict = {}
        self._statics_base: Dict = {}  # 前端下发的静态通道（电压等）
        self._points: List[Dict] = []
        self._active_project: str = ""
        self._search_cfg: Dict = {}
        self._test_phase: str = "A"
        self._harmonic_cfg: Dict = {}

        # 时序参数
        self._fault_duration_ms: int = 1000
        self._pre_fault_duration_ms: int = 1000
        self._simulate_pre_fault: bool = True

        # 硬件参数
        self._logicMask: int = 7
        self._conn_type: str = "ext-differential"
        self._i1_terminal: str = "high-y"
        self._i2_terminal: str = "low-y"

        # 运行状态
        self._fsmState: str = "IDLE"
        self._di_tripped: bool = False
        self._current_node: int = 0
        self._node_done: Optional[asyncio.Event] = None

    # ══════════════════════════════════════════
    # Setup
    # ══════════════════════════════════════════

    def _onSetup(self, params: Dict[str, Any]):
        sys_cfg = params.get("sys", {})
        self._statics_base = params.get("statics", {})
        self._payload = params.get("payload", {})

        self._logicMask = sys_cfg.get("logicMask", 7)

        proj = self._payload.get("projectSettings", {})
        self._active_project = proj.get("activeProject", "ratio-fixed")
        # points 和 search 嵌套在 activeProject 对应的子对象中
        # 例如 ratio-search → projectSettings.ratio.points
        proj_key = self._active_project.split("-")[0]  # "ratio-search" → "ratio"
        proj_data = proj.get(proj_key, proj)  # fallback 到 proj 本身
        self._points = proj_data.get("points", [])
        self._search_cfg = proj_data
        self._test_phase = proj.get("testPhase", "A")
        # 谐波设置可能在 projectSettings.harmonic 或当前 proj_data 内
        self._harmonic_cfg = proj.get("harmonic", {}) or proj_data

        eq_cfg = self._payload.get("equationSettings", {})
        self._ie = float(eq_cfg.get("Ie", 1.0))
        self._is_per_unit = bool(eq_cfg.get("isPerUnit", False))

        test_params = self._payload.get("testParams", {})
        self._fault_duration_ms = int(test_params.get("faultDuration", 1000))
        self._pre_fault_duration_ms = int(test_params.get("preFaultDuration", 1000))
        self._simulate_pre_fault = test_params.get("simulatePreFault", True)

        conn = self._payload.get("connectionSettings", {})
        self._conn_type = conn.get("type", "ext-differential")
        self._i1_terminal = conn.get("i1Terminal", "high-y")
        self._i2_terminal = conn.get("i2Terminal", "low-y")

        if not self._points:
            logger.warning("No test points, stopping.")
            self.ctrl.stopTest("No test points provided")
            return

        logger.info(f"DiffTest setup: project={self._active_project}, "
                    f"connType={self._conn_type}, "
                    f"i1={self._i1_terminal}, i2={self._i2_terminal}, "
                    f"points={len(self._points)}, "
                    f"preFault={self._simulate_pre_fault}/{self._pre_fault_duration_ms}ms, "
                    f"fault={self._fault_duration_ms}ms")
        logger.debug(f"DiffTest protectionSettings: {self._payload.get('protectionSettings', {})}")
        logger.debug(f"DiffTest equationSettings: {self._payload.get('equationSettings', {})}")
        logger.debug(f"DiffTest projectSettings.testPhase: {self._payload.get('projectSettings', {}).get('testPhase')}")

        self._node_done = asyncio.Event()
        self._fsmState = "PREHEAT"
        asyncio.create_task(self._run())

    # ══════════════════════════════════════════
    # 通道解析
    # ══════════════════════════════════════════

    def _resolve_channels(self, terminal: str) -> List[str]:
        """根据接线类型和端子名称，返回 API 通道索引列表"""
        if self._conn_type == "ext-differential":
            return TERMINAL_6I.get(terminal, ["6", "7", "8"])
        else:
            # phase-differential (2I)
            return TERMINAL_2I.get(terminal, ["6"])

    # ══════════════════════════════════════════
    # 节点构建
    # ══════════════════════════════════════════

    def _build_zero_current_statics(self) -> Dict:
        """构建零电流静态字典：保留前端电压通道，所有电流通道归零"""
        statics = {}
        # 保留前端的电压通道
        for ch, layers in self._statics_base.items():
            statics[ch] = dict(layers)
        # 电流通道强制归零 (layer "1" = amplitude + phase)
        for ch_key in ALL_CURRENT_CHANNELS:
            statics[ch_key] = {"1": [0.0, 0.0]}
        return statics

    def _build_fault_statics_6i(self, channels: List[List[float]]) -> Dict:
        """6I 模式：将 compute_6ch 的 6 路电流合并到 statics"""
        statics = {}
        for ch, layers in self._statics_base.items():
            statics[ch] = dict(layers)

        # 先归零所有电流通道 (layer "1" = amplitude + phase)
        for ch_key in ALL_CURRENT_CHANNELS:
            statics[ch_key] = {"1": [0.0, 0.0]}

        # 填入计算的电流
        ch1_keys = self._resolve_channels(self._i1_terminal)
        ch2_keys = self._resolve_channels(self._i2_terminal)
        for i, ch_key in enumerate(ch1_keys):
            statics[ch_key] = {"1": list(channels[i])}
        for i, ch_key in enumerate(ch2_keys):
            statics[ch_key] = {"1": list(channels[3 + i])}
        return statics

    def _build_fault_statics_2i(self, side1: List[float], side2: List[float]) -> Dict:
        """2I 模式：将 compute_2i 的 2 路电流输出到对应的并联通道（均分电流）"""
        statics = {}
        for ch, layers in self._statics_base.items():
            statics[ch] = dict(layers)

        # 先归零所有电流通道 (layer "1" = amplitude + phase)
        for ch_key in ALL_CURRENT_CHANNELS:
            statics[ch_key] = {"1": [0.0, 0.0]}

        # 侧1：并联通道均分电流 (iout / N)
        ch1_keys = self._resolve_channels(self._i1_terminal)
        n1 = len(ch1_keys)
        side1_divided = [side1[0] / n1, side1[1]]  # 幅值均分，角度不变
        for ch_key in ch1_keys:
            statics[ch_key] = {"1": list(side1_divided)}

        # 侧2：并联通道均分电流 (iout / N)
        ch2_keys = self._resolve_channels(self._i2_terminal)
        n2 = len(ch2_keys)
        side2_divided = [side2[0] / n2, side2[1]]  # 幅值均分，角度不变
        for ch_key in ch2_keys:
            statics[ch_key] = {"1": list(side2_divided)}

        return statics

    def _build_prefault_node(self) -> ApiNodeData:
        """Node 1: 故障前状态 — 零电流 + 电压，超时跳转 Node 2"""
        zero_statics = self._build_zero_current_statics()
        n = ApiNodeData(mode=1)
        n.base = self.physDictToReg(zero_statics)
        n.timeoutMs = self._pre_fault_duration_ms
        n.timeoutId = 2
        return n

    def _build_fault_node_6i(self, channels: List[List[float]]) -> ApiNodeData:
        """Node 2 (6I): 故障态 — 6 路电流，DI 匹配或超时跳转 Node 3"""
        fault_statics = self._build_fault_statics_6i(channels)
        n = ApiNodeData(mode=1)
        n.base = self.physDictToReg(fault_statics)
        n.diMatchMask = self._logicMask
        n.diMatchId = 3
        n.timeoutMs = self._fault_duration_ms
        n.timeoutId = 3
        return n

    def _build_fault_node_2i(self, side1: List[float], side2: List[float]) -> ApiNodeData:
        """Node 2 (2I): 故障态 — 2 路电流（并联），DI 匹配或超时跳转 Node 3"""
        fault_statics = self._build_fault_statics_2i(side1, side2)
        n = ApiNodeData(mode=1)
        n.base = self.physDictToReg(fault_statics)
        n.diMatchMask = self._logicMask
        n.diMatchId = 3
        n.timeoutMs = self._fault_duration_ms
        n.timeoutId = 3
        return n

    def _build_idle_node(self) -> ApiNodeData:
        """Node 3: 挂起态 — 零电流 + 电压，无超时无 DI，等待手动触发"""
        zero_statics = self._build_zero_current_statics()
        n = ApiNodeData(mode=1)
        n.base = self.physDictToReg(zero_statics)
        return n

    # ══════════════════════════════════════════
    # 计算并构建故障节点（统一入口）
    # ══════════════════════════════════════════

    def _compute_and_build_fault(self, ir: float, id_val: float) -> tuple:
        """
        根据接线类型计算电流并构建 Node 2。
        返回 (ApiNodeData, fault_statics, i1_amp, i2_amp) — 同时返回 report 用的幅值和物理静态电流字典。

        注意：FPGA 写入的是幅度值（峰值），前端发送的 ir/id 是有效值（RMS）。
        因此在此处将 ir/id 乘以 √2 后再进行通道计算，使输出为峰值。
        返回给前端 report 的 i1_amp/i2_amp 保持 RMS（除回 √2）。
        """
        SQRT2 = math.sqrt(2)

        # FPGA 峰值补偿：RMS → 峰值
        ir_peak = ir * SQRT2
        id_peak = id_val * SQRT2

        if self._conn_type == "ext-differential":
            channels = compute_6ch(ir_peak, id_peak, self._payload)
            labels = ['Ia', 'Ib', 'Ic', 'Ix', 'Iy', 'Iz']
            logger.debug(f"compute_6ch(ir={ir}, id={id_val}, peak×√2):")
            for i, (amp, ang) in enumerate(channels):
                if amp > 0.001:
                    logger.debug(f"  {labels[i]}: {amp:.4f}A ∠{ang:.2f}°")
            fault_statics = self._build_fault_statics_6i(channels)
            # report 用 RMS 幅值（峰值 / √2）
            i1_rms = channels[0][0] / SQRT2
            i2_rms = channels[3][0] / SQRT2
            return self._build_fault_node_6i(channels), fault_statics, i1_rms, i2_rms
        else:
            sides = compute_2i(ir_peak, id_peak, self._payload)
            logger.debug(f"compute_2i(ir={ir}, id={id_val}, peak×√2): "
                         f"side1=[{sides[0][0]:.4f}A ∠{sides[0][1]:.2f}°] "
                         f"side2=[{sides[1][0]:.4f}A ∠{sides[1][1]:.2f}°]")
            fault_statics = self._build_fault_statics_2i(sides[0], sides[1])
            # report 用 RMS 幅值（峰值 / √2）
            i1_rms = sides[0][0] / SQRT2
            i2_rms = sides[1][0] / SQRT2
            return self._build_fault_node_2i(sides[0], sides[1]), fault_statics, i1_rms, i2_rms

    # ══════════════════════════════════════════
    # 主运行循环
    # ══════════════════════════════════════════

    async def _run(self):
        """主协程：预热 → 构建固定节点 → 逐点执行"""
        logger.info("Preheat 500ms...")
        await asyncio.sleep(0.5)
        if not self.isActive:
            return

        self._fsmState = "RUNNING"

        # 预编译 Node 1 和 Node 3（整个试验中不变）
        nodes_fixed = {}
        if self._simulate_pre_fault:
            nodes_fixed[1] = self._build_prefault_node()
        nodes_fixed[3] = self._build_idle_node()
        self.ctrl.upsertNodes(nodes_fixed)

        await asyncio.sleep(0.05)
        if not self.isActive:
            return

        # 根据项目类型执行
        if self._active_project == "ratio-fixed":
            await self._run_fixed()
        elif self._active_project == "ratio-search":
            await self._run_search()
        elif self._active_project == "harmonic-fixed":
            await self._run_harmonic_fixed()
        elif self._active_project == "harmonic-search":
            await self._run_harmonic_search()
        else:
            logger.warning(f"Unsupported project: {self._active_project}")

        # 全部完成
        if self.isActive:
            self._fsmState = "DONE"
            self.ctrl.stopTest()

    # ══════════════════════════════════════════
    # 单次测试循环（公共逻辑）
    # ══════════════════════════════════════════

    async def _test_one_point(self, ir: float, id_val: float) -> tuple:
        """
        执行一次单点测试：计算电流 → 写入 Node 2 → 触发 → 等待结果
        返回：(tripped, fault_statics, i1_amp, i2_amp)
        """
        if not self.isActive:
            return False, {}, 0.0, 0.0

        # 如果是标幺值模式，输入值乘以 Ie 转换为工程物理值进行物理计算
        if self._is_per_unit:
            ir_calc = ir * self._ie
            id_calc = id_val * self._ie
        else:
            ir_calc = ir
            id_calc = id_val

        # 1. 计算并构建 Node 2（自动区分 6I/2I，同时返回 report 幅值和物理静态字典）
        fault_node, fault_statics, i1_amp, i2_amp = self._compute_and_build_fault(ir_calc, id_calc)

        # 2. 更新 Node 2
        self.ctrl.upsertNodes({2: fault_node})

        await asyncio.sleep(0.05)
        if not self.isActive:
            return False, {}, 0.0, 0.0

        # 3. 重置状态，触发测试
        self._di_tripped = False
        self._current_node = 0
        self._node_done.clear()

        start_node = 1 if self._simulate_pre_fault else 2
        self.ctrl.trigNode(start_node)

        # 4. 等待 Node 3 被激活（说明 Node 2 已完成），30s 超时保护
        try:
            await asyncio.wait_for(self._node_done.wait(), timeout=30.0)
        except asyncio.TimeoutError:
            logger.error("Node 3 wait timeout (30s), aborting point")
            return False, {}, 0.0, 0.0

        return self._di_tripped, fault_statics, i1_amp, i2_amp

    # ══════════════════════════════════════════
    # ratio-fixed: 定点测试
    # ══════════════════════════════════════════

    async def _run_fixed(self):
        """对每个定点 {id, x, y}，执行一次测试并上报"""
        for pt in self._points:
            if not self.isActive:
                return

            pt_id = pt.get("id", 0)
            ir = pt.get("x", 0.0)
            id_val = pt.get("y", 0.0)

            logger.info(f"Fixed #{pt_id}: ir={ir}, id={id_val}")

            tripped, fault_statics, i1_amp, i2_amp = await self._test_one_point(ir, id_val)

            # 发送 value_update（右图轨迹点）
            self.ctrl._send({
                "type": "value_update",
                "id": pt_id,
                "x": ir,
                "y": round(id_val, 6),
                "static": fault_statics,
                "di": self.ctrl.di,
                "do": self.ctrl.do
            })

            # 只有动作了才上报 report
            if tripped:
                self.ctrl.sendReport({
                    "points": [{
                        "id": pt_id,
                        "x": ir,
                        "y": round(id_val, 6),
                        "i1": round(i1_amp, 4),
                        "i2": round(i2_amp, 4),
                    }]
                })

    # ══════════════════════════════════════════
    # ratio-search: 二分搜索
    # ══════════════════════════════════════════

    async def _run_search(self):
        """对每个搜索点 {id, x, y:[y0,y1]}，二分搜索动作边界"""
        precision = self._search_cfg.get("precision", 0.01)

        for pt in self._points:
            if not self.isActive:
                return

            pt_id = pt.get("id", 0)
            x_val = pt.get("x")
            y_val = pt.get("y")

            # 判断搜索方向：哪个是区间就搜索哪个
            if isinstance(y_val, list) and len(y_val) >= 2:
                # ratio-search: 固定 x=ir, 搜索 y=id
                ir_fixed = x_val
                search_min, search_max = y_val[0], y_val[1]
                await self._binary_search(pt_id, ir_fixed, search_min, search_max, precision, axis="y")
            elif isinstance(x_val, list) and len(x_val) >= 2:
                # harmonic-search: 固定 y=id, 搜索 x
                id_fixed = y_val
                search_min, search_max = x_val[0], x_val[1]
                await self._binary_search(pt_id, id_fixed, search_min, search_max, precision, axis="x")
            else:
                logger.warning(f"Point #{pt_id}: neither x nor y is a range, skipping")

    async def _binary_search(self, pt_id: int, fixed_val: float,
                              search_min: float, search_max: float,
                              precision: float, axis: str):
        """
        通用二分搜索。
        """
        last_i1, last_i2 = 0.0, 0.0

        async def checkTrip(pt: Tuple[float]) -> bool:
            nonlocal last_i1, last_i2
            val = pt[0]
            if axis == "y":
                ir, id_val = fixed_val, val
            else:
                ir, id_val = val, fixed_val

            tripped, fault_statics, i1_amp, i2_amp = await self._test_one_point(ir, id_val)

            if self.isActive:
                self.ctrl._send({
                    "type": "value_update",
                    "id": pt_id,
                    "x": round(ir, 6),
                    "y": round(id_val, 6),
                    "static": fault_statics,
                    "di": self.ctrl.di,
                    "do": self.ctrl.do
                })

            if tripped:
                last_i1, last_i2 = i1_amp, i2_amp

            return tripped

        boundary_pt = await searchBoundary(
            (search_min,), (search_max,), precision, checkTrip, 0
        )

        if boundary_pt is not None:
            result_val = boundary_pt[0]
            if axis == "y":
                report_x, report_id = fixed_val, result_val
            else:
                report_x, report_id = result_val, fixed_val

            self.ctrl.sendReport({
                "points": [{
                    "id": pt_id,
                    "x": round(report_x, 6),
                    "y": round(report_id, 6),
                    "i1": round(last_i1, 4),
                    "i2": round(last_i2, 4),
                }]
            })
        else:
            logger.warning(f"Search #{pt_id}: Boundary not found (start & end states matched).")

    # ══════════════════════════════════════════
    # 谐波制动：注入与节点
    # ══════════════════════════════════════════

    def _build_harmonic_statics(self, harm_pct: float, id_val: float) -> Dict:
        """谐波制动注入。

        模拟变压器励磁涌流：电流仅流入被激励侧（applySide），故差动电流 = 注入电流 = Id，
        在该侧叠加 N 次谐波（含量 η%）。另一侧电流为 0。

          applySide 通道：layer "1" = 基波 Id；layer str(order) = N 次谐波(η%·Id)
          其余电流通道：0

        N 次谐波频率由 FPGA 按 regIndex(=层号) 自动取 N×基频（DDS 1024 步谐波合成）。
        谐波比 η = I_N / I_1 经线性接线补偿保持不变，故仅需保证同通道基波/谐波比正确。
        """
        SQRT2 = math.sqrt(2)
        order = int(self._harmonic_cfg.get("order", 2))
        err_type = self._harmonic_cfg.get("harmonicErrorType", "relative")
        apply_side = self._harmonic_cfg.get("applySide", "i1")

        statics = {}
        for ch, layers in self._statics_base.items():
            statics[ch] = dict(layers)
        for ch_key in ALL_CURRENT_CHANNELS:
            statics[ch_key] = {"1": [0.0, 0.0]}

        terminal = self._i1_terminal if apply_side == "i1" else self._i2_terminal
        chans = self._resolve_channels(terminal)

        if self._conn_type == "ext-differential":
            # 6I：按测试相挑选侧内相通道，每相承载完整 Id（非并联）
            idxs = [i for i in PHASE_OFFSETS.get(self._test_phase, [0]) if i < len(chans)]
            targets = [chans[i] for i in idxs]
            angles = [NOMINAL_ANG[i] for i in idxs]
            divide = 1
        else:
            # 2I：端子并联通道均分电流，同相位
            targets = chans
            angles = [0.0] * len(chans)
            divide = max(1, len(chans))

        if not targets:
            return statics

        id_peak = id_val * SQRT2 / divide
        if err_type == "absolute":
            harm_peak = harm_pct * SQRT2 / divide          # 绝对谐波电流(A, RMS→峰值)
        else:
            harm_peak = (harm_pct / 100.0) * id_val * SQRT2 / divide  # 相对基波 η%

        for ch_key, ang in zip(targets, angles):
            statics[ch_key] = {
                "1": [id_peak, ang],
                str(order): [harm_peak, ang],
            }
        return statics

    def _build_fault_node_from_statics(self, statics: Dict) -> ApiNodeData:
        """通用故障节点：DI 匹配或超时跳转 Node 3。"""
        n = ApiNodeData(mode=1)
        n.base = self.physDictToReg(statics)
        n.diMatchMask = self._logicMask
        n.diMatchId = 3
        n.timeoutMs = self._fault_duration_ms
        n.timeoutId = 3
        return n

    async def _test_one_harmonic_point(self, harm_pct: float, id_val: float) -> tuple:
        """施加一次谐波注入点，返回 (是否动作, fault_statics)。"""
        if not self.isActive:
            return False, {}

        id_calc = id_val * self._ie if self._is_per_unit else id_val
        fault_statics = self._build_harmonic_statics(harm_pct, id_calc)
        self.ctrl.upsertNodes({2: self._build_fault_node_from_statics(fault_statics)})

        await asyncio.sleep(0.05)
        if not self.isActive:
            return False, {}

        self._di_tripped = False
        self._current_node = 0
        self._node_done.clear()

        start_node = 1 if self._simulate_pre_fault else 2
        self.ctrl.trigNode(start_node)

        try:
            await asyncio.wait_for(self._node_done.wait(), timeout=30.0)
        except asyncio.TimeoutError:
            logger.error("Harmonic point: Node 3 wait timeout (30s)")
            return False, {}

        return self._di_tripped, fault_statics

    # ══════════════════════════════════════════
    # harmonic-fixed: 谐波定点
    # ══════════════════════════════════════════

    async def _run_harmonic_fixed(self):
        """每个定点 {id, x:谐波%, y:Id}：施加并上报是否被闭锁。"""
        for pt in self._points:
            if not self.isActive:
                return
            pt_id = pt.get("id", 0)
            harm_pct = pt.get("x", 0.0)
            id_val = pt.get("y", 0.0)

            logger.info(f"Harmonic fixed #{pt_id}: harm%={harm_pct}, Id={id_val}")
            tripped, fault_statics = await self._test_one_harmonic_point(harm_pct, id_val)

            self.ctrl._send({
                "type": "value_update",
                "id": pt_id,
                "x": round(harm_pct, 6),
                "y": round(id_val, 6),
                "static": fault_statics,
                "di": self.ctrl.di,
                "do": self.ctrl.do,
            })

            # tripped=True → 未被谐波闭锁；False → 已闭锁
            self.ctrl.sendReport({
                "points": [{
                    "id": pt_id,
                    "x": round(harm_pct, 6),
                    "y": round(id_val, 6),
                    "blocked": (not tripped),
                }]
            })

    # ══════════════════════════════════════════
    # harmonic-search: 谐波闭锁门槛搜索
    # ══════════════════════════════════════════

    async def _run_harmonic_search(self):
        """每个搜索点 {id, y:Id, x:[x0,x1]}：二分搜索谐波闭锁门槛。"""
        precision = self._search_cfg.get("precision", 0.01)
        for pt in self._points:
            if not self.isActive:
                return
            pt_id = pt.get("id", 0)
            id_fixed = pt.get("y")
            x_val = pt.get("x")
            if not (isinstance(x_val, list) and len(x_val) >= 2):
                logger.warning(f"Harmonic search #{pt_id}: x is not a range, skipping")
                continue
            await self._binary_search_harmonic(pt_id, id_fixed, x_val[0], x_val[1], precision)

    async def _binary_search_harmonic(self, pt_id: int, id_fixed: float,
                                      hmin: float, hmax: float, precision: float):
        """二分谐波闭锁门槛。
        """
        async def checkTrip(pt: Tuple[float]) -> bool:
            val = pt[0]
            tripped, fault_statics = await self._test_one_harmonic_point(val, id_fixed)

            if self.isActive:
                self.ctrl._send({
                    "type": "value_update",
                    "id": pt_id,
                    "x": round(val, 6),
                    "y": round(id_fixed, 6),
                    "static": fault_statics,
                    "di": self.ctrl.di,
                    "do": self.ctrl.do,
                })
            
            return tripped

        boundary_pt = await searchBoundary(
            (hmin,), (hmax,), precision, checkTrip, 0
        )

        if boundary_pt is not None:
            threshold = boundary_pt[0]
            self.ctrl.sendReport({
                "points": [{
                    "id": pt_id,
                    "x": round(threshold, 6),
                    "y": round(id_fixed, 6),
                    "blocked": True,
                }]
            })
        else:
            logger.warning(f"Harmonic search #{pt_id}: Boundary not found.")

    # ══════════════════════════════════════════
    # 硬件回调
    # ══════════════════════════════════════════

    def onUpdate(self, nodeId: int, tick: int, hw_ts: int):
        """节点跳转回调：当 nodeId=3 且 tick=0 时，说明 Node 2 已结束"""
        self._current_node = nodeId
        if nodeId == 3 and tick == 0 and self._node_done:
            self._node_done.set()

    def onDi(self, di: int, hw_ts: int):
        """
        DI 变化回调。
        OR/AND 逻辑已由硬件 FSM 的 diMatchMask 处理。
        此处仅做标记，用于区分 Node 2 是 DI 触发跳转还是超时跳转。
        """
        if self._fsmState != "RUNNING":
            return
        if self._current_node == 2:
            self._di_tripped = True

    def _onStop(self):
        self._fsmState = "IDLE"
        if self._node_done:
            self._node_done.set()
        logger.info("DifferentialTest stopped.")

    def onWebCommand(self, msg: Dict[str, Any]):
        cmd = msg.get("cmd")
        if cmd == "stop":
            self.ctrl.stopTest()
